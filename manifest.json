{
  "manifest_version": 3,
  "name": "Notes Sync Helper",
  "version": "1.0.3",
  "description": "Sync your notes across devices.",
  "permissions": ["alarms"],
  "host_permissions": ["https://*.workers.dev/*", "https://api.ipify.org/*"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Notes Sync",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
